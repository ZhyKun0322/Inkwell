<% var title = 'Chat' %>
<% var active = 'chat' %>
<%- include('partials/header') %>

<div class="page-title-row"><h1>Chat</h1></div>

<div class="chat-layout">
  <div class="chat-sidebar">
    <% if (friends.length === 0) { %>
      <div style="padding: 16px; color: var(--ink-soft); font-size: 0.85rem;">Add friends to start chatting.</div>
    <% } %>
    <% friends.forEach(function(f) { %>
      <a href="/chat/<%= f.id %>" class="<%= activeFriend && activeFriend.id === f.id ? 'active' : '' %>">
        <span class="avatar avatar-sm" style="background: <%- f.avatar.gradient %>;"><%= f.avatar.initials %></span>
        @<%= f.username %>
      </a>
    <% }) %>
  </div>

  <div class="chat-main">
    <% if (!activeFriend) { %>
      <div class="chat-empty">Pick a friend on the left to start chatting.</div>
    <% } else { %>
      <div class="chat-header">
        <span class="avatar avatar-sm" style="background: <%- activeFriend.avatar.gradient %>;"><%= activeFriend.avatar.initials %></span>
        @<%= activeFriend.username %>
      </div>
      <div class="chat-messages" id="messages">
        <% messages.forEach(function(m) { %>
          <div class="msg <%= m.mine ? 'mine' : 'theirs' %>">
            <%= m.text %>
            <span class="time"><%= new Date(m.createdAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></span>
          </div>
        <% }) %>
      </div>
      <form class="chat-input" id="chat-form">
        <input type="text" id="chat-text" placeholder="Write a message…" autocomplete="off" required>
        <button type="submit" class="btn btn-primary">Send</button>
      </form>
    <% } %>
  </div>
</div>

<% if (activeFriend) { %>
<script src="/socket.io/socket.io.js"></script>
<script>
  const room = "<%= room %>";
  const myId = "<%= currentUser.id %>";
</script>
<script src="/js/chat-client.js"></script>
<% } %>

<%- include('partials/footer') %>
