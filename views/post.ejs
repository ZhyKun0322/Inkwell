<% var title = post.title %>
<%- include('partials/header') %>

<div class="story-hero" style="background: <%- post.cover.gradient %>;">
  <span class="pill"><%= post.genre %></span>
  <% if (!post.published) { %><span class="pill" style="margin-left:6px;">Draft</span><% } %>
  <h1><%= post.title %></h1>
  <div class="byline">
    <span class="avatar avatar-sm" style="background: rgba(255,255,255,0.3);"><%= authorAvatar.initials %></span>
    <a href="/profile/<%= authorUsername %>">@<%= authorUsername %></a>
    <span>&middot; <%= new Date(post.createdAt).toLocaleDateString() %></span>
  </div>
</div>

<div class="story-body"><%= post.content %></div>

<div class="story-actions">
  <form method="POST" action="/post/<%= post.id %>/like">
    <button type="submit" class="btn like-btn <%= likedByMe ? 'liked' : '' %>">
      <%= likedByMe ? '♥ Liked' : '♡ Like' %> (<%= likeCount %>)
    </button>
  </form>
</div>

<div class="comments">
  <h3 class="section-title">Comments (<%= comments.length %>)</h3>

  <% comments.forEach(function(c) { %>
    <div class="comment">
      <span class="avatar avatar-sm" style="background: <%- c.avatar.gradient %>;"><%= c.avatar.initials %></span>
      <div class="bubble">
        <div class="who">@<%= c.authorUsername %> &middot; <%= new Date(c.createdAt).toLocaleDateString() %></div>
        <p><%= c.text %></p>
      </div>
    </div>
  <% }) %>

  <form method="POST" action="/post/<%= post.id %>/comment" style="margin-top: 20px;">
    <textarea name="text" placeholder="Add a comment…" style="min-height: 80px;" required></textarea>
    <div style="margin-top: 10px;">
      <button type="submit" class="btn btn-primary">Comment</button>
    </div>
  </form>
</div>

<%- include('partials/footer') %>
