<% var title = '@' + profileUser.username %>
<% var active = isOwner ? 'profile' : '' %>
<%- include('partials/header') %>

<div class="profile-head">
  <span class="avatar avatar-lg" style="background: <%- profileAvatar.gradient %>;"><%= profileAvatar.initials %></span>
  <div style="flex:1;">
    <div class="eyebrow">Writer &amp; Reader</div>
    <div class="username"><b>@<%= profileUser.username %></b></div>
    <% if (profileUser.bio) { %><div class="bio"><%= profileUser.bio %></div><% } %>

    <% if (!isOwner) { %>
      <div style="margin-top: 12px;">
        <% if (!friendship) { %>
          <form method="POST" action="/friends/request/<%= profileUser.username %>">
            <button type="submit" class="btn btn-primary">+ Add Friend</button>
          </form>
        <% } else if (friendship.status === 'pending') { %>
          <span class="pill draft">Friend request pending</span>
        <% } else { %>
          <a href="/chat/<%= profileUser.id %>" class="btn btn-primary">Message</a>
        <% } %>
      </div>
    <% } %>
  </div>
</div>

<% if (isOwner) { %>
  <div class="section-title">Edit bio</div>
  <form method="POST" action="/profile/bio" style="margin-bottom: 10px; background:var(--surface); padding:16px; border-radius: var(--radius-md); box-shadow: var(--shadow-sm);">
    <textarea name="bio" placeholder="Tell readers about yourself…" style="min-height: 70px;"><%= profileUser.bio || '' %></textarea>
    <div style="margin-top: 8px;"><button type="submit" class="btn">Save bio</button></div>
  </form>
<% } %>

<div class="section-title"><%= isOwner ? 'Your bookshelf' : 'Published stories' %></div>

<% if (posts.length === 0) { %>
  <div class="empty"><%= isOwner ? 'You haven\'t written anything yet.' : 'No published stories yet.' %></div>
<% } else { %>
  <div class="shelf">
    <% posts.forEach(function(post) { %>
      <a href="/post/<%= post.id %>" class="book">
        <div class="book-cover" style="background: <%- post.cover.gradient %>;">
          <span class="initials"><%= post.cover.initials %></span>
          <span class="cover-title"><%= post.title %></span>
        </div>
        <div class="book-info">
          <span class="pill <%= post.published ? '' : 'draft' %>"><%= post.published ? post.genre : 'Draft' %></span>
          <div class="stats"><span>♥ <%= post.likeCount %></span></div>
        </div>
      </a>
    <% }) %>
  </div>
<% } %>

<%- include('partials/footer') %>
